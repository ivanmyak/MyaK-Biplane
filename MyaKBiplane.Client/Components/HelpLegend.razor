@* Легенда управления. На ПК и на тач-устройствах показываются разные подсказки. *@

<div class="help-legend @(Compact ? "help-legend-compact" : string.Empty)">
    <div class="controls-grid">
        <article class="controls-card help-desktop">
            <h2>Биплан</h2>
            <ul>
                <li><kbd>W</kbd> / <kbd>S</kbd> — тяга вперёд / назад</li>
                <li><kbd>A</kbd> / <kbd>D</kbd> — поворот</li>
                <li><kbd>ЛКМ</kbd> или <kbd>F</kbd> — огонь</li>
                <li><kbd>R</kbd> — перезарядка магазина (5 патронов)</li>
                <li><kbd>Пробел</kbd> — ускорение, снова доступно после кулдауна</li>
            </ul>
        </article>

        <article class="controls-card help-desktop">
            <h2>Птеродактиль</h2>
            <ul>
                <li><kbd>WASD</kbd> — движение</li>
                <li><kbd>Мышь</kbd> — прицел</li>
                <li><kbd>ЛКМ</kbd> — зарядить и бросить копьё</li>
                <li><kbd>Пробел</kbd> — рывок</li>
            </ul>
        </article>

        <article class="controls-card help-touch">
            <h2>Управление на экране</h2>
            <ul>
                <li>Биплан: слева руль-стик (влево/вправо), справа крест: X — огонь, A — газ, B — ускорение, R — перезарядка</li>
                <li>Птеро: слева 2D-стик движения, справа X — полупрозрачная зона броска со стрелкой</li>
                <li>Y — кнопка лётчика: выпрыгнуть / купол / убрать купол</li>
                <li>Иконка рядом — ускорение или рывок; «Пауза» слева вверху</li>
            </ul>
        </article>

        <article class="controls-card help-touch">
            <h2>Лётчик на экране</h2>
            <ul>
                <li>Кнопка-парашют: выпрыгнуть, раскрыть или сложить купол</li>
                <li>Бежите к башне-маяку, чтобы получить новый аппарат</li>
                <li>Рядом со своим бесхозным аппаратом та же кнопка возвращает в него</li>
                <li>Перезарядка и восстановление способности — жёлтые полосы у аппарата</li>
            </ul>
        </article>

        <article class="controls-card help-desktop">
            <h2>Лётчик</h2>
            <ul>
                <li><kbd>E</kbd> — катапультироваться / забраться обратно</li>
                <li><kbd>Пробел</kbd> — раскрыть или сложить парашют</li>
                <li><kbd>A</kbd> / <kbd>D</kbd> — управление и планирование</li>
                @if (Compact)
                {
                    <li><kbd>Esc</kbd> — пауза и меню матча</li>
                }
                else
                {
                    <li>Планирование и парашют гасят падение до безопасной скорости</li>
                    <li>Слишком быстрое падение разбивает лётчика</li>
                    <li>Доберитесь до башни-маяка за новым аппаратом</li>
                }
            </ul>
        </article>

        @if (!Compact)
        {
            <article class="controls-card help-desktop">
                <h2>Правила боя</h2>
                <ul>
                    <li>Матч до 10 уничтожений</li>
                    <li>Аппарат появляется у своей стороны и неуязвим, пока выезжает на позицию</li>
                    <li>Разбитый о землю аппарат с лётчиком приносит очко сопернику</li>
                    <li>Сбитый или разбившийся лётчик приносит очко сопернику</li>
                    <li>Попадание в купол уничтожает парашют до возрождения</li>
                    <li><kbd>Esc</kbd> — пауза для обоих игроков</li>
                </ul>
            </article>

            <p class="help-note help-desktop">
                Нос аппарата после появления смотрит в сторону верхнего угла соперника —
                наберите высоту, прежде чем вступать в бой.
            </p>
        }
    </div>
</div>

@code {
    /// <summary>
    /// Сжатый вариант для окна паузы.
    /// </summary>
    [Parameter]
    public bool Compact { get; set; }
}
