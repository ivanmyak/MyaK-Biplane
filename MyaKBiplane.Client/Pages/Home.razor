@page "/"
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IConfiguration Configuration

<PageTitle>@GameInfo.Title</PageTitle>

<main class="menu-shell">
    <section class="menu-card">
        <div class="menu-head">
            <p class="eyebrow">2D dogfight prototype</p>
            <div class="menu-head-actions">
                @if (!string.IsNullOrWhiteSpace(_telegramName))
                {
                    <span class="telegram-chip" title="Telegram Mini App">TG · @_telegramName</span>
                }
                <button type="button"
                        class="theme-toggle"
                        title="@ThemeLabel"
                        aria-label="@ThemeLabel"
                        @onclick="ToggleThemeAsync">
                    <span class="theme-toggle-icon" aria-hidden="true">@ThemeIcon</span>
                    <span>@ThemeLabel</span>
                </button>
            </div>
        </div>
        <h1>@GameInfo.Title</h1>
        <p class="subtitle">
            Матч до 5 уничтожений. В центре карты — башня-маяк: аппараты появляются
            по разные её стороны, а лётчик может катапультироваться и добраться до
            башни за новым аппаратом.
        </p>

        @if (_view == "main")
        {
            <div class="menu-actions">
                <button class="button button-primary" @onclick="ShowBot">
                    Игра с ботом
                </button>
                <button class="button button-secondary" @onclick="ShowOnline">
                    Игра по сети
                </button>
                <button class="button button-ghost" @onclick="ShowHelp">
                    Помощь
                </button>
            </div>
        }
        else if (_view == "bot")
        {
            <h2 class="step-title">Выберите аппарат</h2>
            @AircraftPicker()
            <p class="step-hint">Противник — бот на аппарате противоположного класса.</p>
            <div class="menu-actions">
                <button class="button button-primary" @onclick="StartBot">
                    Начать бой с ботом
                </button>
                <button class="button button-ghost" @onclick="BackToMain">Назад</button>
            </div>
        }
        else if (_view == "online")
        {
            <h2 class="step-title">Сетевая игра в одной сети</h2>
            <p class="step-hint">
                Создайте комнату и передайте код сопернику. Второй игрок выбирает
                свой аппарат — классы могут совпадать.
            </p>
            <div class="menu-actions">
                <button class="button button-primary" @onclick="ShowHost">
                    Создать комнату
                </button>
                <button class="button button-secondary" @onclick="ShowJoin">
                    Присоединиться по коду
                </button>
                <button class="button button-ghost" @onclick="BackToMain">Назад</button>
            </div>
        }
        else if (_view == "host")
        {
            <h2 class="step-title">Комната: выберите свой аппарат</h2>
            @AircraftPicker()
            <p class="step-hint">После создания комнаты покажите сопернику её код.</p>
            <div class="menu-actions">
                <button class="button button-primary" @onclick="StartHost">
                    Создать комнату
                </button>
                <button class="button button-ghost" @onclick="ShowOnline">Назад</button>
            </div>
        }
        else if (_view == "join")
        {
            <h2 class="step-title">Присоединение к комнате</h2>
            <label class="field-label" for="room-code">Код комнаты</label>
            <input id="room-code"
                   class="text-input room-code-input"
                   maxlength="6"
                   autocomplete="off"
                   @bind="_joinCode"
                   @bind:event="oninput" />
            <h2 class="step-title">Выберите свой аппарат</h2>
            @AircraftPicker()
            <div class="menu-actions">
                <button class="button button-primary"
                        disabled="@(!CanJoin)"
                        @onclick="StartJoin">
                    Войти в комнату
                </button>
                <button class="button button-ghost" @onclick="ShowOnline">Назад</button>
            </div>
        }

        else if (_view == "help")
        {
            <h2 class="step-title">Помощь</h2>
            <p class="step-hint">
                Управление, правила боя и спасение лётчика. Эта же легенда
                открывается на паузе по <kbd>Esc</kbd>.
            </p>
            <HelpLegend />
            <div class="menu-actions">
                <button class="button button-primary" @onclick="BackToMain">Назад</button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p class="menu-error">@_error</p>
        }

        @* Версия видна и в главном меню, и на экране помощи. *@
        <p class="version-badge">MyaK Biplane · v@Version</p>
    </section>
</main>

@code {
    private string _view = "main";
    private PlaneKind _kind = PlaneKind.Biplane;
    private string _joinCode = string.Empty;
    private string? _error;
    private string _theme = "dark";
    private string _telegramName = string.Empty;

    private string Version => Configuration["App:Version"] ?? "0.0.0";

    private string ThemeLabel => _theme == "light" ? "Тёмная тема" : "Светлая тема";

    private string ThemeIcon => _theme == "light" ? "☾" : "☀";

    private bool CanJoin => _joinCode.Trim().Length >= 4;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        // В WASM JS-рантайм синхронный: забираем тему до первой отрисовки,
        // чтобы кнопка сразу показывала правильное действие.
        if (JS is IJSInProcessRuntime inProcess)
        {
            try
            {
                _theme = inProcess.Invoke<string>("myakTheme.current");
            }
            catch (JSException)
            {
                // Остаёмся на тёмной теме по умолчанию.
            }
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _telegramName = await JS.InvokeAsync<string>("myakTelegram.displayName");
            await JS.InvokeVoidAsync("myakTelegram.setGameActive", false);
            await JS.InvokeVoidAsync("myakTelegram.setScrollLocked", false);
            await JS.InvokeVoidAsync("myakTelegram.setBackButton", false);
        }
        catch (JSException)
        {
            // Вне Telegram приветствие не нужно.
        }

        if (!string.IsNullOrWhiteSpace(_telegramName))
        {
            StateHasChanged();
        }
    }

    private async Task ToggleThemeAsync()
    {
        try
        {
            _theme = await JS.InvokeAsync<string>("myakTheme.toggle");
        }
        catch (JSException)
        {
            _theme = _theme == "light" ? "dark" : "light";
        }
    }

    private void ShowBot()
    {
        _view = "bot";
        _error = null;
    }

    private void ShowOnline()
    {
        _view = "online";
        _error = null;
    }

    private void ShowHost()
    {
        _view = "host";
        _error = null;
    }

    private void ShowJoin()
    {
        _view = "join";
        _joinCode = string.Empty;
        _error = null;
    }

    private void BackToMain()
    {
        _view = "main";
        _error = null;
    }

    private void ShowHelp()
    {
        _view = "help";
        _error = null;
    }

    private void StartBot()
    {
        Navigation.NavigateTo($"{Navigation.BaseUri}play?mode=bot&kind={KindName(_kind)}");
    }

    private void StartHost()
    {
        Navigation.NavigateTo($"{Navigation.BaseUri}play?mode=host&kind={KindName(_kind)}");
    }

    private void StartJoin()
    {
        var code = _joinCode.Trim().ToUpperInvariant();

        if (code.Length < 4)
        {
            _error = "Введите код комнаты.";
            return;
        }

        Navigation.NavigateTo(
            $"{Navigation.BaseUri}play?mode=join&kind={KindName(_kind)}&code={Uri.EscapeDataString(code)}");
    }

    private RenderFragment AircraftPicker() =>
        @<div class="aircraft-grid">
            <button class="aircraft-card @(_kind == PlaneKind.Biplane ? "selected" : string.Empty)"
                    @onclick="() => _kind = PlaneKind.Biplane">
                <span class="aircraft-badge">БИ</span>
                <strong>Биплан</strong>
                <span class="aircraft-desc">
                    Скоростной самолёт. Магазин на 5 «горошин», перезарядка вручную.
                </span>
            </button>
            <button class="aircraft-card @(_kind == PlaneKind.Pterodactyl ? "selected" : string.Empty)"
                    @onclick="() => _kind = PlaneKind.Pterodactyl">
                <span class="aircraft-badge aircraft-badge-alt">ПТ</span>
                <strong>Птеродактиль</strong>
                <span class="aircraft-desc">
                    Манёвренный ящер. Заряжаемое копьё и рывок.
                </span>
            </button>
        </div>;

    private static string KindName(PlaneKind kind) =>
        kind == PlaneKind.Biplane ? "biplane" : "pterodactyl";
}
