@page "/play"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<PageTitle>@GameInfo.Title</PageTitle>

<div class="game-shell">
    <canvas id="gameCanvas" class="game-canvas"></canvas>

    <a class="back-link" href="@Navigation.BaseUri">← В меню</a>

    @* Сенсорное управление: видно только на телефоне/в Telegram mobile. *@
    <div class="touch-controls @(_room?.Status == "playing" || _warmupActive ? "touch-controls-active" : string.Empty)"
         aria-hidden="true">
        @* Стик движения появляется там, куда игрок положил палец. *@
        <div class="touch-move-zone" data-touch-zone="move">
            <div class="touch-stick touch-stick-move" data-touch-stick="move">
                <span class="touch-stick-knob"></span>
            </div>
        </div>

        <div class="touch-cluster">
            <button type="button" class="touch-button touch-context touch-action-eject"
                    data-touch-action="context" data-touch-state="eject"
                    aria-label="Покинуть аппарат">E</button>

            <button type="button" class="touch-button touch-reload touch-reload-loaded"
                    data-touch-action="reload" aria-label="Перезарядка">R</button>

            <button type="button" class="touch-button touch-fire" data-touch-action="fire"
                    aria-label="Огонь">
                <span class="touch-fire-label">Огонь</span>
                <span class="throw-arrow" aria-hidden="true">
                    <span class="throw-arrow-head"></span>
                </span>
            </button>

            <button type="button" class="touch-button touch-ability" data-touch-action="ability"
                    aria-label="Способность">
                <span class="touch-ability-label">@(_kind == PlaneKind.Biplane ? "Ускор." : "Рывок")</span>
            </button>

            <button type="button" class="touch-button touch-button-pause" data-touch-action="pause"
                    aria-label="Пауза">II</button>
        </div>
    </div>

    @if (_room is not null && (_room.Status != "waiting" || _warmupActive))
    {
        <div class="game-meta">
            <span>@(Mode == "bot" ? "Игра с ботом" : _warmupActive ? "Сетевая игра · тренировка" : ModeLabel)</span>
            @if (!string.IsNullOrEmpty(_room.Code))
            {
                <span>Код: <strong>@_room.Code</strong></span>
            }
            <span>До победы: <strong>@_room.Settings.ScoreToWin</strong></span>
            @if (!_room.Settings.AllowSameKind)
            {
                <span>Разные аппараты</span>
            }
            @if (!_room.Settings.AllowEjection)
            {
                <span>Без катапульты</span>
            }
            @if (!string.IsNullOrWhiteSpace(_kindAdjustedNotice))
            {
                <span>Аппарат изменён хозяином</span>
            }
            <span title="@RawPingDetails">@(Mode == "bot" ? "LOCAL" : "P2P") · Ping: @PingLabel · RAW: @RawPingLabel</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_closedReason))
    {
        <div class="game-overlay">
            <div class="overlay-panel">
                <p class="overlay-eyebrow">Матч закрыт</p>
                <h2>Соперник вышел</h2>
                <p class="overlay-text">@_closedReason</p>
                <div class="overlay-actions">
                    <button class="button button-primary" @onclick="ExitToMenuAsync">В меню</button>
                </div>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="game-overlay">
            <div class="overlay-panel">
                <p class="overlay-eyebrow">Ошибка подключения</p>
                <h2>Не удалось войти в матч</h2>
                <p class="overlay-text">@_error</p>
                @if (!string.IsNullOrEmpty(ServerHealthUrl))
                {
                    <p class="overlay-text">
                        Проверка связи: <a href="@ServerHealthUrl" target="_blank" rel="noreferrer">@ServerHealthUrl</a>
                    </p>
                }
                <div class="overlay-actions">
                    <button class="button button-primary" @onclick="RetryConnectAsync">Повторить</button>
                    <button class="button button-ghost" @onclick="ExitToMenuAsync">В меню</button>
                </div>
            </div>
        </div>
    }
    else if (_room is null)
    {
        <div class="game-overlay">
            <div class="overlay-panel compact">
                <p class="overlay-eyebrow">Подключение</p>
                <h2>Соединяемся с сервером…</h2>
                <div class="loading-dots"><span></span><span></span><span></span></div>
            </div>
        </div>
    }
    else if (_manual is not null && _room is not null && !_room.PeerConnected && !_warmupActive)
    {
        <div class="game-overlay">
            <div class="overlay-panel">
                <p class="overlay-eyebrow">@(Mode == "host" ? "Шаг 1 · хост" : "Шаг 2 · гость")</p>
                <h2>@(Mode == "host" ? "Код приглашения" : "Код ответа")</h2>
                <p class="overlay-text">
                    @if (Mode == "host")
                    {
                        <text>Отправьте этот код сопернику. Когда он вернёт вам код ответа, вставьте его ниже.</text>
                    }
                    else
                    {
                        <text>Отправьте этот код хозяину комнаты. После этого соединение установится само.</text>
                    }
                </p>

                <textarea class="code-area" rows="3" readonly>@_manual.OutgoingCode</textarea>

                <div class="overlay-actions">
                    <button class="button button-secondary" @onclick="CopyManualCodeAsync">
                        Скопировать код
                    </button>
                </div>

                @if (Mode == "host")
                {
                    <label class="field-label" for="answer-code">Код ответа от соперника</label>
                    <textarea id="answer-code" class="code-area" rows="3"
                              @bind="_answerCode" @bind:event="oninput"></textarea>
                    <div class="overlay-actions">
                        <button class="button button-primary"
                                disabled="@(string.IsNullOrWhiteSpace(_answerCode))"
                                @onclick="AcceptAnswerAsync">
                            Подключить соперника
                        </button>
                        <button class="button button-ghost" @onclick="StartWarmupAsync">
                            Тренировка с ботом
                        </button>
                        <button class="button button-ghost" @onclick="ExitToMenuAsync">Отменить</button>
                    </div>
                }

                @RulesPanel(_room, Mode == "host" ? "Правила комнаты" : "Хозяин изменил правила")

                @if (!string.IsNullOrWhiteSpace(_kindAdjustedNotice))
                {
                    <p class="overlay-notice">@_kindAdjustedNotice</p>
                }
            </div>
        </div>
    }
    else if (_room is not null && _room.Status == "waiting" && !_warmupActive)
    {
        <div class="game-overlay">
            <div class="overlay-panel">
                <p class="overlay-eyebrow">Комната создана</p>
                <h2>Ожидание соперника</h2>
                <p class="overlay-text">
                    Передайте сопернику код комнаты. Второй игрок выбирает свой аппарат
                    на стартовом экране.
                </p>
                <div class="room-code">@_room.Code</div>

                @RulesPanel(_room, "Правила комнаты")

                <div class="overlay-actions">
                    <button class="button button-secondary" @onclick="CopyCodeAsync">
                        Скопировать код
                    </button>
                    <button class="button button-primary" @onclick="StartWarmupAsync">
                        Тренировка с ботом
                    </button>
                    <button class="button button-ghost" @onclick="ExitToMenuAsync">Отменить</button>
                </div>
            </div>
        </div>
    }
    else if (_warmupActive && _warmupFinished)
    {
        <div class="game-overlay">
            <div class="overlay-panel">
                <p class="overlay-eyebrow">Тренировка · комната @_room!.Code</p>
                <h2>Тренировка завершена</h2>
                <div class="score-line">
                    <span class="score-you">@_warmupYourScore</span>
                    <span class="score-sep">:</span>
                    <span class="score-opponent">@_warmupOpponentScore</span>
                </div>
                <p class="overlay-text">Соперник ещё не подключился — можно сыграть ещё раз.</p>
                <div class="overlay-actions">
                    <button class="button button-primary" @onclick="RetryWarmupAsync">
                        Ещё тренировка
                    </button>
                    <button class="button button-secondary" @onclick="StopWarmupAsync">
                        Вернуться к ожиданию
                    </button>
                </div>
            </div>
        </div>
    }
    else if (_room is not null && _room.Status != "waiting" && !_room.PeerConnected)
    {
        <div class="game-overlay">
            <div class="overlay-panel compact">
                <p class="overlay-eyebrow">Прямое соединение</p>
                <h2>Соединяемся с соперником…</h2>
                <p class="overlay-text">
                    Игра начнётся, когда прямое соединение между игроками будет установлено.
                    Сервер больше не участвует в матче.
                </p>

                @if (!string.IsNullOrWhiteSpace(_kindAdjustedNotice))
                {
                    <p class="overlay-notice">@_kindAdjustedNotice</p>
                }

                @RulesPanel(_room, Mode == "host" ? "Правила комнаты" : "Хозяин изменил правила")

                <div class="loading-dots"><span></span><span></span><span></span></div>
            </div>
        </div>
    }
    else if (_room is not null && _room.Status is "paused" or "finished")
    {
        <div class="game-overlay">
            <div class="overlay-panel">
                @if (_room.Status == "finished")
                {
                    <p class="overlay-eyebrow">Матч завершён</p>
                    <h2 class="@OutcomeClass">@OutcomeTitle</h2>
                    <div class="score-line">
                        <span class="score-you">@_yourScore</span>
                        <span class="score-sep">:</span>
                        <span class="score-opponent">@_opponentScore</span>
                    </div>
                    <p class="overlay-text">
                        @(_opponentIsBot ? "Счёт против бота" : "Счёт по уничтожениям")
                    </p>
                }
                else
                {
                    <p class="overlay-eyebrow">Пауза</p>
                    <h2>Игра приостановлена</h2>
                    <p class="overlay-text">@PauseText</p>
                }

                @if (!string.IsNullOrWhiteSpace(_room.Notice))
                {
                    <p class="overlay-notice">@_room.Notice</p>
                }

                <HelpLegend Compact="true" />

                @if (_room.RematchOfferedByOpponent)
                {
                    <p class="overlay-notice offer">
                        Соперник предлагает реванш.
                    </p>
                }
                else if (_room.RematchOfferedByYou)
                {
                    <p class="overlay-notice">Ожидание ответа соперника…</p>
                }

                <div class="overlay-actions">
                    @if (_room.Status == "paused")
                    {
                        <button class="button button-primary"
                                disabled="@_busy"
                                @onclick="ResumeAsync">
                            Продолжить
                        </button>
                    }

                    @if (_room.RematchOfferedByOpponent)
                    {
                        <button class="button button-primary"
                                disabled="@_busy"
                                @onclick="() => RespondRematchAsync(true)">
                            Принять реванш
                        </button>
                        <button class="button button-ghost"
                                disabled="@_busy"
                                @onclick="() => RespondRematchAsync(false)">
                            Отказаться
                        </button>
                    }
                    else if (!_room.RematchOfferedByYou)
                    {
                        <button class="button button-secondary"
                                disabled="@_busy"
                                @onclick="OfferRematchAsync">
                            @(_room.Mode == "bot" ? "Реванш" : "Предложить реванш")
                        </button>
                    }

                    <button class="button button-ghost"
                            disabled="@_busy"
                            @onclick="ExitToMenuAsync">
                        В меню
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_warmupActive && !_warmupFinished)
    {
        <div class="warmup-banner">
            <div class="warmup-text">
                <strong>Тренировка с ботом</strong>
                <span>Комната @_room!.Code ждёт соперника</span>
            </div>
            <button class="button button-ghost button-small" @onclick="StopWarmupAsync">
                Закончить
            </button>
        </div>
    }
</div>

@code {
    private const string CanvasId = "gameCanvas";

    private static readonly JsonSerializerOptions SnapshotOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private IMatchClient? _client;
    private IManualMatchClient? _manual;
    private LocalMatchClient? _warmup;
    private DotNetObjectReference<Play>? _dotNetRef;
    private RoomInfo? _room;
    private string? _error;
    private string? _closedReason;
    private string _latestSnapshot = string.Empty;
    private string _answerCode = string.Empty;
    private PlaneKind _kind;
    private PlaneKind _requestedKind;
    private RoomSettings _hostSettings = RoomSettings.Default;
    private string? _kindAdjustedNotice;
    private bool _warmupActive;
    private bool _warmupFinished;
    private int _warmupYourScore;
    private int _warmupOpponentScore;
    private bool _started;
    private bool _busy;
    private int _winnerSlot = -1;
    private int _yourScore;
    private int _opponentScore;
    private bool _opponentIsBot;
    private double _rttMs = -1;
    private double _rawMin = -1;
    private double _rawAvg = -1;
    private double _rawMax = -1;
    private CancellationTokenSource? _rttCts;

    [SupplyParameterFromQuery(Name = "mode")]
    public string? Mode { get; set; }

    [SupplyParameterFromQuery(Name = "kind")]
    public string? Kind { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    public string? Code { get; set; }

    [SupplyParameterFromQuery(Name = "limit")]
    public int? Limit { get; set; }

    [SupplyParameterFromQuery(Name = "sameKind")]
    public bool? SameKind { get; set; }

    [SupplyParameterFromQuery(Name = "eject")]
    public bool? Eject { get; set; }

    private string ModeLabel => Mode switch
    {
        "host" => "Сетевая игра · хозяин комнаты",
        "join" => "Сетевая игра · гость",
        _ => "Игра с ботом"
    };

    private string OutcomeTitle => _winnerSlot < 0
        ? "НИЧЬЯ"
        : _room is not null && _winnerSlot == _room.YourSlot
            ? "ПОБЕДА"
            : "ПОРАЖЕНИЕ";

    private string OutcomeClass => _winnerSlot < 0
        ? "overlay-draw"
        : _room is not null && _winnerSlot == _room.YourSlot
            ? "overlay-win"
            : "overlay-loss";

    private string PingLabel => _rttMs < 0 ? "—" : $"{_rttMs:0} мс";

    private string RawPingLabel => _rawAvg < 0 ? "—" : $"{_rawAvg:0} мс";

    private string RawPingDetails => _rawAvg < 0
        ? "Чистый WebSocket-RTT: нет данных"
        : $"Чистый WebSocket-RTT: мин {_rawMin:0} / ср {_rawAvg:0} / макс {_rawMax:0} мс";

    /// <summary>Адрес проверки доступности сервера — его можно открыть с телефона.</summary>
    private string ServerHealthUrl => _client?.HubUri is { } hubUri
        ? new UriBuilder(hubUri)
        {
            Scheme = "https",
            Path = "/health",
            Query = string.Empty,
            Fragment = string.Empty
        }.Uri.ToString()
        : string.Empty;

    private string PauseText => _room is not null && _room.PausedBySlot == _room.YourSlot        ? "Вы поставили игру на паузу. Соперник тоже видит это окно."
        : "Соперник поставил игру на паузу. Продолжить может любой из вас.";

    protected override void OnInitialized()
    {
        _kind = Enum.TryParse<PlaneKind>(Kind, ignoreCase: true, out var parsed)
            ? parsed
            : PlaneKind.Biplane;
        _requestedKind = _kind;

        // Хозяин передаёт свои правила через ссылку, а сервер повторно их проверяет.
        _hostSettings = new RoomSettings
        {
            ScoreToWin = System.Math.Clamp(
                Limit ?? RoomSettings.DefaultScoreToWin,
                RoomSettings.MinScoreToWin,
                RoomSettings.MaxScoreToWin),
            AllowSameKind = SameKind ?? true,
            AllowEjection = Eject ?? true
        }.Normalized();

        // Матч с ботом считается локально; сетевой матч идёт напрямую между игроками.
        // Сервер в обоих случаях не участвует в расчёте игры.
        _client = Mode switch
        {
            null or "bot" => new LocalMatchClient(_kind),
            _ => new P2pMatchClient(Configuration, JS)
        };

        _manual = _client as IManualMatchClient;

        _client.RoomUpdated += OnRoomUpdated;
        _client.SnapshotReceived += OnSnapshotReceived;
        _client.RoomClosed += OnRoomClosed;
        _client.ConnectionClosed += OnConnectionClosed;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started)
        {
            return;
        }

        _started = true;
        _dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("myakBiplane.start", _dotNetRef, CanvasId);
        await SetTelegramModeAsync(true);
        await SetScrollLockedAsync(true);
        var joinCode = await ReadJoinCodeAsync();
        await ConnectAndEnterAsync(joinCode);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Вызывается JavaScript-рендерером один раз за кадр.
    /// </summary>
    /// <param name="timestamp">Метка времени requestAnimationFrame в миллисекундах.</param>
    /// <param name="input">Текущий ввод игрока.</param>
    /// <returns>Последний JSON-снимок состояния.</returns>
    [JSInvokable]
    public string Tick(double timestamp, InputState input)
    {
        var warmup = _warmup;

        if (_warmupActive && warmup is not null)
        {
            return warmup.Tick(input, timestamp);
        }

        if (_client is null || _room?.Status != "playing")
        {
            return _latestSnapshot;
        }

        return _client.Tick(input, timestamp);
    }

    /// <summary>
    /// Переключает паузу по Escape.
    /// </summary>
    [JSInvokable]
    public async Task TogglePause()
    {
        if (_client is null || _room is null || _room.Status is not ("playing" or "paused"))
        {
            return;
        }

        await RunAsync(() => _client.TogglePauseAsync());
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_warmup is not null)
        {
            _warmup.SnapshotReceived -= OnWarmupSnapshot;
            await _warmup.DisposeAsync();
            _warmup = null;
        }

        _rttCts?.Cancel();
        _rttCts?.Dispose();
        _rttCts = null;

        if (_client is not null)
        {
            _client.RoomUpdated -= OnRoomUpdated;
            _client.SnapshotReceived -= OnSnapshotReceived;
            _client.RoomClosed -= OnRoomClosed;
            _client.ConnectionClosed -= OnConnectionClosed;

            try
            {
                await _client.LeaveRoomAsync();
            }
            catch (Exception)
            {
                // Соединение уже могло закрыться.
            }

            await _client.DisposeAsync();
            _client = null;
        }

        if (_started)
        {
            try
            {
                await JS.InvokeVoidAsync("myakBiplane.stop", CanvasId);
            }
            catch (Exception)
            {
                // Страница уже могла быть выгружена браузером.
            }
        }

        await SetTelegramModeAsync(false);
        await SetScrollLockedAsync(false);
        _dotNetRef?.Dispose();
    }

    private async Task ConnectAndEnterAsync(string? joinCode = null)
    {
        if (_client is null)
        {
            return;
        }

        _error = null;

        try
        {
            await _client.ConnectAsync();

            _room = Mode switch
            {
                "host" => await _client.CreateRoomAsync(KindName(_kind), _hostSettings),
                "join" => await _client.JoinRoomAsync(joinCode ?? Code ?? string.Empty, KindName(_kind)),
                _ => await _client.CreateBotRoomAsync(KindName(_kind))
            };

            // Класс аппарата берём из ответа сервера: даже если параметр ссылки потерялся,
            // управление и кнопки будут соответствовать реальному аппарату в матче.
            UpdateKindNotice(_room);
            ApplyKindFromRoom(_room);

            // Диагностика задержки нужна только в сетевом матче.
            if (_client.HubUri is not null && _rttCts is null)
            {
                _rttCts = new CancellationTokenSource();
                _ = MeasureRttLoopAsync(_rttCts.Token);
                _ = MeasureRawRttAsync();
            }
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            await SetScrollLockedAsync(false);
        }
    }

    /// <summary>Повторная попытка подключения по кнопке на экране ошибки.</summary>
    private async Task RetryConnectAsync()
    {
        await SetScrollLockedAsync(true);
        var joinCode = await ReadJoinCodeAsync();
        await ConnectAndEnterAsync(joinCode);
        await InvokeAsync(StateHasChanged);
    }

    private async Task MeasureRttLoopAsync(CancellationToken cancellationToken)
    {
        while (!cancellationToken.IsCancellationRequested)
        {
            try
            {
                var rtt = await _client!.MeasureRttAsync();

                if (rtt >= 0)
                {
                    _rttMs = rtt;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (Exception)
            {
                // Соединение могло закрыться — следующая итерация просто не измерит RTT.
            }

            try
            {
                await Task.Delay(TimeSpan.FromSeconds(5), cancellationToken);
            }
            catch (OperationCanceledException)
            {
                break;
            }
        }
    }

    private async Task MeasureRawRttAsync()
    {
        try
        {
            if (_client?.HubUri is not { } hubUri)
            {
                return;
            }

            var echoUri = new UriBuilder(hubUri)
            {
                Scheme = hubUri.Scheme == "https" ? "wss" : "ws",
                Path = "/ws/ping",
                Query = string.Empty,
                Fragment = string.Empty
            };

            // 10 проб по отдельному echo-сокету: без SignalR и маршаллинга .NET<->JS.
            var values = await JS.InvokeAsync<double[]>(
                "myakNetDiag.measure", echoUri.Uri.ToString(), 10, 3000);

            if (values is { Length: >= 3 })
            {
                _rawMin = values[0];
                _rawAvg = values[1];
                _rawMax = values[2];
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception)
        {
            // Диагностика не должна ломать матч.
        }
    }

    private async Task SetTelegramModeAsync(bool active)
    {
        try
        {
            await JS.InvokeVoidAsync("myakTelegram.setGameActive", active);
            await JS.InvokeVoidAsync("myakTelegram.setBackButton", active);
        }
        catch (JSException)
        {
            // Вне Telegram и при выгрузке страницы эти вызовы не нужны.
        }
    }

    private async Task SetScrollLockedAsync(bool locked)
    {
        try
        {
            await JS.InvokeVoidAsync("myakTelegram.setScrollLocked", locked);
        }
        catch (JSException)
        {
            // Вне Telegram свайпы не управляются.
        }
    }

    private async Task RunAsync(Func<Task> action)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();

        try
        {
            await action();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task ResumeAsync() =>
        _client is null ? Task.CompletedTask : RunAsync(() => _client.TogglePauseAsync());

    private Task OfferRematchAsync() =>
        _client is null ? Task.CompletedTask : RunAsync(() => _client.OfferRematchAsync());

    private Task RespondRematchAsync(bool accept) =>
        _client is null ? Task.CompletedTask : RunAsync(() => _client.RespondRematchAsync(accept));

    private async Task CopyCodeAsync()
    {
        if (_room is null || string.IsNullOrEmpty(_room.Code))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("myakBiplane.copyText", _room.Code);
        }
        catch (Exception)
        {
            // Буфер обмена может быть недоступен.
        }
    }

    private async Task<string?> ReadJoinCodeAsync()
    {
        try
        {
            var code = await JS.InvokeAsync<string?>("sessionStorage.getItem", "myakJoinCode");
            await JS.InvokeVoidAsync("sessionStorage.removeItem", "myakJoinCode");
            return code;
        }
        catch (JSException)
        {
            return null;
        }
    }

    private async Task CopyManualCodeAsync()
    {
        if (_manual?.OutgoingCode is null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("myakBiplane.copyText", _manual.OutgoingCode);
        }
        catch (Exception)
        {
            // Буфер обмена может быть недоступен — код можно выделить вручную.
        }
    }

    private Task AcceptAnswerAsync() =>
        _manual is null
            ? Task.CompletedTask
            : RunAsync(() => _manual.AcceptCodeAsync(_answerCode));

    private async Task ExitToMenuAsync()
    {
        if (_client is not null)
        {
            try
            {
                await _client.LeaveRoomAsync();
            }
            catch (Exception)
            {
                // Соединение уже могло закрыться.
            }
        }

        Navigation.NavigateTo(Navigation.BaseUri);
    }

    private void UpdateKindNotice(RoomInfo info)
    {
        _kindAdjustedNotice = null;

        if (Mode != "join"
            || info.Settings.AllowSameKind
            || string.IsNullOrWhiteSpace(info.GuestKind)
            || !Enum.TryParse<PlaneKind>(info.GuestKind, ignoreCase: true, out var actualKind)
            || actualKind == _requestedKind)
        {
            return;
        }

        _kindAdjustedNotice =
            $"Хозяин запретил одинаковые аппараты, поэтому вам выдан «{KindTitle(actualKind)}».";
    }

    private static List<string> CustomRuleLines(RoomInfo? room)
    {
        var lines = new List<string>();

        if (room is null)
        {
            return lines;
        }

        var settings = room.Settings;

        if (settings.ScoreToWin != RoomSettings.DefaultScoreToWin)
        {
            lines.Add(
                $"Победа — {settings.ScoreToWin} {KillsWord(settings.ScoreToWin)} " +
                $"(обычно {RoomSettings.DefaultScoreToWin}).");
        }

        if (!settings.AllowSameKind)
        {
            lines.Add("Одинаковые аппараты запрещены: у игроков будут разные классы.");
        }

        if (!settings.AllowEjection)
        {
            lines.Add("Катапультирование запрещено: покинуть аппарат нельзя.");
        }

        return lines;
    }

    private static string KillsWord(int count)
    {
        var mod100 = count % 100;
        var mod10 = count % 10;

        if (mod10 == 1 && mod100 != 11)
        {
            return "уничтожение";
        }

        var few = mod10 is >= 2 and <= 4;
        var notTeen = mod100 is < 12 or > 14;

        if (few && notTeen)
        {
            return "уничтожения";
        }

        return "уничтожений";
    }

    private static string KindTitle(PlaneKind kind) =>
        kind == PlaneKind.Biplane ? "Биплан" : "Птеродактиль";

    private RenderFragment RulesPanel(RoomInfo? room, string title) =>
        @<text>
            @if (CustomRuleLines(room) is { Count: > 0 } lines)
            {
                <div class="rules-panel">
                    <p class="rules-title">@title</p>
                    <ul class="rules-list">
                        @foreach (var line in lines)
                        {
                            <li>@line</li>
                        }
                    </ul>
                </div>
            }
        </text>;

    private async Task StartWarmupAsync()
    {
        if (_room is null || _warmup is not null)
        {
            return;
        }

        try
        {
            var warmup = new LocalMatchClient(_kind, _room.Settings);
            await warmup.ConnectAsync();
            await warmup.CreateBotRoomAsync(KindName(_kind));

            warmup.SnapshotReceived += OnWarmupSnapshot;
            _warmup = warmup;
            _warmupActive = true;
            _warmupFinished = false;
            _warmupYourScore = 0;
            _warmupOpponentScore = 0;
            _latestSnapshot = string.Empty;

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
    }

    private async Task RetryWarmupAsync()
    {
        if (_warmup is null)
        {
            await StartWarmupAsync();
            return;
        }

        _warmupFinished = false;
        _warmupYourScore = 0;
        _warmupOpponentScore = 0;
        await _warmup.OfferRematchAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task StopWarmupAsync()
    {
        var warmup = _warmup;
        _warmup = null;
        _warmupActive = false;
        _warmupFinished = false;
        _latestSnapshot = string.Empty;

        if (warmup is not null)
        {
            warmup.SnapshotReceived -= OnWarmupSnapshot;
            await warmup.DisposeAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    private void OnWarmupSnapshot(string json)
    {
        GameSnapshot? snapshot;

        try
        {
            snapshot = JsonSerializer.Deserialize<GameSnapshot>(json, SnapshotOptions);
        }
        catch (JsonException)
        {
            return;
        }

        if (snapshot is null)
        {
            return;
        }

        var yourSlot = snapshot.YourSlot;
        var yourScore = snapshot.Scores.Length > yourSlot ? snapshot.Scores[yourSlot] : 0;
        var opponentScore = snapshot.Scores.Length > 1 - yourSlot
            ? snapshot.Scores[1 - yourSlot]
            : 0;
        var finished = snapshot.WinnerSlot >= 0;

        _ = InvokeAsync(() =>
        {
            _warmupYourScore = yourScore;
            _warmupOpponentScore = opponentScore;

            if (finished)
            {
                _warmupFinished = true;
            }

            StateHasChanged();
        });
    }

    private void OnRoomUpdated(RoomInfo info)
    {
        _ = InvokeAsync(async () =>
        {
            _room = info;
            ApplyKindFromRoom(info);
            UpdateKindNotice(info);

            // Соперник подключился — локальная тренировка больше не нужна.
            if (_warmupActive && (info.OpponentConnected || info.Status != "waiting"))
            {
                await StopWarmupAsync();
            }

            // На паузе/финише оверлей может быть выше экрана — свайпы нужны,
            // чтобы его прокрутить. В живом бою они мешают экранным стикам.
            await SetScrollLockedAsync(info.Status == "playing");
            StateHasChanged();
        });
    }

    /// <summary>
    /// Приводит класс аппарата к тому, который выдал сервер: источник правды — матч,
    /// а не параметр ссылки.
    /// </summary>
    private void ApplyKindFromRoom(RoomInfo? info)
    {
        if (info is null)
        {
            return;
        }

        var name = info.YourSlot == 0 ? info.HostKind : info.GuestKind;

        if (!string.IsNullOrWhiteSpace(name)
            && Enum.TryParse<PlaneKind>(name, ignoreCase: true, out var kind))
        {
            _kind = kind;
        }
    }

    private void OnSnapshotReceived(string json)
    {
        Interlocked.Exchange(ref _latestSnapshot, json);

        GameSnapshot? snapshot;

        try
        {
            snapshot = JsonSerializer.Deserialize<GameSnapshot>(json, SnapshotOptions);
        }
        catch (JsonException)
        {
            return;
        }

        if (snapshot is null)
        {
            return;
        }

        var yourSlot = snapshot.YourSlot;
        var yourScore = snapshot.Scores.Length > yourSlot ? snapshot.Scores[yourSlot] : 0;
        var opponentScore = snapshot.Scores.Length > 1 - yourSlot ? snapshot.Scores[1 - yourSlot] : 0;
        var opponentIsBot = false;

        foreach (var plane in snapshot.Planes)
        {
            if (plane.Slot != yourSlot && plane.IsBot)
            {
                opponentIsBot = true;
                break;
            }
        }

        if (snapshot.WinnerSlot == _winnerSlot
            && yourScore == _yourScore
            && opponentScore == _opponentScore
            && opponentIsBot == _opponentIsBot)
        {
            return;
        }

        _winnerSlot = snapshot.WinnerSlot;
        _yourScore = yourScore;
        _opponentScore = opponentScore;
        _opponentIsBot = opponentIsBot;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnRoomClosed(string reason)
    {
        _ = InvokeAsync(async () =>
        {
            _closedReason = string.IsNullOrWhiteSpace(reason)
                ? "Соперник покинул игру."
                : reason;
            _room = null;
            await SetScrollLockedAsync(false);
            StateHasChanged();
        });
    }

    private void OnConnectionClosed(string reason)
    {
        if (!string.IsNullOrWhiteSpace(_closedReason))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            _closedReason = string.IsNullOrWhiteSpace(reason)
                ? "Соединение с сервером закрыто."
                : reason;
            _room = null;
            await SetScrollLockedAsync(false);
            StateHasChanged();
        });
    }

    private static string KindName(PlaneKind kind) =>
        kind == PlaneKind.Biplane ? "biplane" : "pterodactyl";
}
