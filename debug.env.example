# Локальное окружение для docker-compose.debug.yml.
# Скопируйте файл в debug.env и заполните значения. debug.env в git не попадает.
#
# Важно: compose НЕ создаёт свой Postgres. Используется существующий
# контейнер postgresdb из внешней сети shared-net.
# Запуск: docker compose --env-file debug.env -f docker-compose.debug.yml up -d

# --- Docker ---
DOCKER_REGISTRY=
SERVER_PORT=5080
CLIENT_PORT=5081
TZ=Europe/Moscow

# --- Логирование ---
Logging__LogLevel__Default=Debug
Logging__LogLevel__MyaKBiplane=Debug
LoggingProviders__Console=true
LoggingProviders__File=true
LoggingProviders__Monitoring=false

# --- Внешний PostgreSQL из shared-net ---
# Замените host/user/password на параметры вашего общего контейнера.
ConnectionStrings__Postgres=Host=postgresdb;Port=5432;Database=myakbiplane;Username=postgres;Password=change_me
