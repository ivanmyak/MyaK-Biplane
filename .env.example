# Секреты и локальное окружение для docker compose (release).
# Скопируйте файл в .env и заполните значения. .env в git не попадает.

# --- Docker ---
DOCKER_REGISTRY=
SERVER_PORT=8080
CLIENT_PORT=8081
TZ=Europe/Moscow

# --- Логирование ---
Logging__LogLevel__MyaKBiplane=Information
LoggingProviders__Console=true
LoggingProviders__File=true
LoggingProviders__Monitoring=true

# --- PostgreSQL (задел под будущий онлайн-профиль) ---
# В release-сборке база пока не используется симуляцией.
ConnectionStrings__Postgres=Host=postgresdb;Port=5432;Database=myakbiplane;Username=myakbiplane;Password=change_me
