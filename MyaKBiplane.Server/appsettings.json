{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "MyaKBiplane": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LoggingProviders": {
    "Console": true,
    "File": true,
    "Monitoring": true
  },
  "LogFiles": {
    "Root": "Data/Logs",
    "RetentionDays": 30
  },
  "App": {
    "Version": "0.0.0"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://ivanmyak.github.io",
      "http://localhost:5000",
      "https://localhost:5001",
      "http://localhost:5049",
      "http://localhost:5081",
      "http://localhost:5173",
      "http://localhost:8080",
      "http://localhost:8081"
    ]
  },
  "AllowedHosts": "*"
}
